# Salin file ini menjadi .env.local lalu isi key. File .env.local jangan di-commit.
# JANGAN memakai awalan NEXT_PUBLIC_ / VITE_ / PUBLIC_ untuk key: nilainya akan masuk bundle browser.

# Provider bawaan di selector: apmix atau xkiro. Kosong = provider pertama yang key-nya terisi (apmix lebih dulu).
# DEFAULT_PROVIDER=xkiro

# ---------------- xKiro (https://docs.xkiro.com) ----------------
# Wajib untuk chat. Daftar model (GET /v1/models) bersifat publik, jadi katalog tetap tampil tanpa key.
XKIRO_API_KEY=isi_key_xkiro_anda
XKIRO_BASE_URL=https://api.xkiro.com/v1

# Opsional (nilai di bawah adalah bawaan)
# XKIRO_DEFAULT_MODEL=                     # dipilih bila belum ada pilihan; kosong = model gratis pertama dari katalog
# XKIRO_MODEL_CACHE_TTL_SECONDS=300        # umur cache daftar model
# XKIRO_MODELS_TIMEOUT_MS=10000
# XKIRO_CONNECT_TIMEOUT_MS=30000           # sampai respons mulai datang; stream sesudahnya tidak dibatasi
# XKIRO_REQUEST_TIMEOUT_MS=100000          # permintaan non-stream
# XKIRO_MAX_RETRIES=3                      # 0 = matikan retry
# XKIRO_RETRY_BASE_MS=500                  # backoff 500, 1000, 2000 ms (+ jitter)
# XKIRO_RETRY_MAX_DELAY_MS=8000
# XKIRO_RETRY_STATUSES=429,500,502,503,504,529
# XKIRO_FALLBACK_MODELS=                   # ID dipisah koma; dipakai HANYA jika katalog tak terjangkau dan belum ada cache

# ---------------- APMIX (provider lama) ----------------
APMIX_API_KEY=apx_live_isi_key_anda_di_sini
APMIX_BASE_URL=https://api.apmix.ai/v1
APMIX_DEFAULT_MODEL=gpt-6-luna-free
# openai (POST /v1/chat/completions) atau anthropic (POST /v1/messages)
APMIX_API_FORMAT=openai
